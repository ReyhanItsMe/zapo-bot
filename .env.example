# ══════════════════════════════════════════════════════════════
#  zapo-bot — contoh konfigurasi. Salin file ini menjadi `.env`
#  lalu isi. JANGAN commit file `.env` asli ke git / jangan
#  dibagikan ke siapa pun (berisi rahasia).
# ══════════════════════════════════════════════════════════════

# ── Identitas bot ─────────────────────────────────────────────
# Nama bot yang tampil di menu & pesan sambutan.
BOT_NAME=ZapoBot
# Prefix perintah. Pisahkan dengan koma bila lebih dari satu.
# Contoh: PREFIX=.,!,#  → perintah dipanggil dengan .ping / !ping / #ping
PREFIX=.
# Nama sesi (kunci kredensial di store). Ganti bila ingin memakai
# nomor lain di folder yang sama — sesi lama tidak tertimpa.
SESSION_ID=default
# Zona waktu untuk reset limit harian & scheduler.
TIMEZONE=Asia/Jakarta

# ── Pemilik bot (WAJIB diisi agar fitur owner jalan) ─────────
# Nomor owner, format internasional TANPA "+" dan TANPA spasi.
# Pisahkan dengan koma bila lebih dari satu. Contoh: 6281234567890,6289876543210
# SENGAJA DIKOSONGKAN di paket jual — isi nomor KAMU sendiri.
OWNER_NUMBERS=

# ── Pairing (cara menautkan nomor bot) ───────────────────────
# false = tampilkan QR code di console (scan dari HP).
# true  = pakai pairing code 8 karakter (butuh PAIRING_NUMBER).
USE_PAIRING_CODE=false
# Nomor bot yang akan ditautkan (digit saja, pakai kode negara).
# Hanya dipakai bila USE_PAIRING_CODE=true.
PAIRING_NUMBER=
# Kode pairing custom 8 karakter (opsional, kosongkan = acak dari server).
# Karakter yang diizinkan WhatsApp: 1-9 dan A-Z tanpa I, O, U, 0.
PAIRING_CODE=

# ── Limit & premium ──────────────────────────────────────────
# Kuota perintah ber-limit per user per hari (reset tengah malam TIMEZONE).
DAILY_LIMIT=25
# Fitur premium aktif? true/false. User premium tidak kena limit harian.
FEATURE_PREMIUM=true

# ── Toggle fitur (bisa juga diatur per-grup lewat database) ──
FEATURE_ANTILINK=false
FEATURE_WELCOME=false
FEATURE_ANTICALL=true
FEATURE_AUTOREAD=false

# ── API eksternal (opsional, untuk contoh plugin ai/tools) ───
# Isi bila mengaktifkan contoh yang membutuhkan API key.
# Bot tetap jalan walau kosong — contoh terkait akan membalas pesan jelas.
AI_API_KEY=
[SECURITY_DATA]
TRANSLATE_API_URL=

# ── Lanjutan ─────────────────────────────────────────────────
# Level log: debug | info | warn | error
LOG_LEVEL=info
# Batas percobaan reconnect otomatis sebelum menyerah (0 = tanpa batas).
MAX_RECONNECT=10
# Jeda minimum antar pesan keluar (ms) — anti pembatasan akun.
SEND_MIN_DELAY_MS=350
# Izinkan perintah eval owner? Sangat berbahaya. Biarkan false kecuali paham risiko.
ALLOW_EVAL=false

# ── Link untuk menu (tombol/kartu) ─────────────────────────────
# Dipakai fungsi ctx.rich.* lewat nama kunci: 'website', 'support', 'channel', 'group', 'github'.
# Kosong = dilewati; 'website' kosong = https://zapo.to
LINK_WEBSITE=
LINK_SUPPORT=
LINK_CHANNEL=
LINK_GROUP=
LINK_GITHUB=
